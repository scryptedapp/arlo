{
   "name": "@scrypted/arlo",
   "version": "0.13.0",
   "description": "Arlo Plugin for Scrypted",
   "license": "Apache-2.0",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/scryptedapp/arlo.git"
   },
   "bugs": {
      "url": "https://github.com/scryptedapp/arlo/issues"
   },
   "homepage": "https://github.com/scryptedapp/arlo",
   "engines": {
      "node": ">=20.11"
   },
   "files": [
      "dist/plugin.zip"
   ],
   "keywords": [
      "scrypted",
      "plugin",
      "arlo",
      "camera"
   ],
   "scripts": {
      "build": "node scripts/impers.mjs --check && scrypted-webpack",
      "prepublishOnly": "node scripts/impers.mjs --check && NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "npm run build",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "scrypted-deploy": "scrypted-deploy",
      "update-impers": "npm install impers@latest && npm install koffi@latest --save-optional --save-exact && node scripts/impers.mjs"
   },
   "scrypted": {
      "name": "Arlo Camera Plugin",
      "type": "DeviceProvider",
      "interfaces": [
         "Settings",
         "DeviceProvider"
      ],
      "pluginDependencies": [
         "@scrypted/prebuffer-mixin",
         "@scrypted/snapshot",
         "@scrypted/webrtc"
      ]
   },
   "dependencies": {
      "imapflow": "^2.12.1",
      "impers": "^0.1.3",
      "mqtt": "^5.16.1",
      "multicast-dns": "^7.2.5",
      "ws": "^8.23.0"
   },
   "devDependencies": {
      "@scrypted/sdk": "^0.5.61",
      "@types/multicast-dns": "^7.2.4",
      "@types/node": "^22.19.0",
      "@types/ws": "^8.18.2",
      "terser-webpack-plugin": "^5.6.1"
   },
   "allowScripts": {
      "fsevents": false,
      "koffi": false
   },
   "overrides": {
      "webpack": "5.108.4"
   },
   "optionalDependencies": {
      "koffi": "3.3.7"
   }
}
