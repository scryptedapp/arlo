{
   "name": "@scrypted/arlo",
   "version": "0.13.0",
   "description": "Arlo Plugin for Scrypted",
   "license": "Apache",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/scryptedapp/arlo.git"
   },
   "bugs": {
      "url": "https://github.com/scryptedapp/arlo/issues"
   },
   "homepage": "https://github.com/scryptedapp/arlo",
   "keywords": [
      "scrypted",
      "plugin",
      "arlo",
      "camera"
   ],
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "koffi-binaries": "node scripts/koffi-binaries.mjs",
      "build": "npm run koffi-binaries && scrypted-webpack",
      "prepublishOnly": "npm run koffi-binaries && NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "npm run build",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-readme": "scrypted-readme",
      "scrypted-package-json": "scrypted-package-json",
      "update-impers": "npm install impers@latest && npm update koffi"
   },
   "scrypted": {
      "name": "Arlo Camera Plugin",
      "type": "DeviceProvider",
      "interfaces": [
         "Settings",
         "DeviceProvider"
      ],
      "pluginDependencies": [
         "@scrypted/prebuffer-mixin",
         "@scrypted/snapshot",
         "@scrypted/webrtc"
      ]
   },
   "dependencies": {
      "impers": "^0.1.3"
   },
   "devDependencies": {
      "@scrypted/sdk": "^0.5.59",
      "@types/node": "^22.19.0",
      "terser-webpack-plugin": "^5.6.1"
   }
}
